# Supabase Postgres connection string (Session pooler empfohlen für Serverless/Container)
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# Beliebiger langer, zufälliger String - schützt alle API-Routen
API_BEARER_TOKEN="change-me"

# https://resend.com/api-keys
RESEND_API_KEY="re_xxx"
# Verifizierte Absenderadresse auf deiner eigenen Domain
RESEND_FROM_EMAIL="Ocean Office <outreach@yourdomain.com>"
# Beliebiges Secret, das du auch im Resend Inbound-Webhook hinterlegst (als Query-Param geprüft)
RESEND_INBOUND_SECRET="change-me-too"

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-xxx"

PORT=3000
